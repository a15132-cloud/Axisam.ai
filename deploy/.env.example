# Copy to deploy/.env (docker compose reads .env from the same folder it
# runs in) and fill in both values before `docker compose up -d --build`.

# Tu clave de https://console.anthropic.com/settings/keys - la unica key
# de todo el sistema, nunca la ve un cliente. Pon un limite de gasto
# mensual ahi mismo (ver README principal, "Evitar quedarte sin creditos").
ANTHROPIC_API_KEY=

# El dominio (sin https://, sin barra final) por el que se va a servir el
# backend - Caddy consigue el certificado HTTPS automaticamente para este
# dominio. Dos opciones:
#   1. Un dominio propio: crea un registro A apuntando a la IP publica de
#      tu VM (api.tu-dominio.com), y pon ese nombre aqui.
#   2. Sin dominio propio: usa sslip.io, que resuelve automaticamente sin
#      configurar nada - si la IP publica de tu VM es 203.0.113.10, pon
#      exactamente: 203-0-113-10.sslip.io
AXISCAM_DOMAIN=
