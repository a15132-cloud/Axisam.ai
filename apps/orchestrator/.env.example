# Copy to .env (or export these directly) before running the orchestrator.
# Optional server-side fallback key for Capa 3 (vision extraction) and Capa 2
# (chat agent loop) - convenient for local dev so you don't have to open the
# app and paste a key every time. In production this can stay empty: each
# browser supplies its own key via the "Configuración" modal (bring-your-own-key,
# see app/api/routes_projects.py::_cliente_de_usuario), which is what lets
# multiple clients use one deployment without the operator paying for
# everyone's usage out of one shared key.
ANTHROPIC_API_KEY=

# Optional overrides - sensible defaults are baked into app/config.py.
# AXISCAM_VISION_MODEL=claude-sonnet-5
# AXISCAM_AGENT_MODEL=claude-sonnet-5
# AXISCAM_STORAGE_DIR=./data
# AXISCAM_DEFAULT_POSTPROCESSOR=haas_vf_generico
# AXISCAM_CORS_ORIGINS=http://localhost:5173
